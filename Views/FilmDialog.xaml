<Window x:Class="Kino.Views.FilmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kino.Views"
        mc:Ignorable="d"
        Title=" Создание (редактирование) фильма"  
        Height="400" Width="350" 
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="350"
        ResizeMode="NoResize">

    <!-- Основной контейнер (Grid) -->
    <Grid Margin="5" Background="#FFDBDA">
        <!-- 9 строк сетки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Строка 0: Название фильма -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 1: Жанр -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 2: Режиссёр -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 3: Продолжительность -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 4: Возрастное ограничение -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 5: (заполнитель для ComboBox) -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 6: Цена билета -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 7: Сообщение об ошибке -->
            <RowDefinition Height="*"/>
            <!-- Строка 8: Кнопки (занимает остаток места) -->
        </Grid.RowDefinitions>

        <!-- 2 колонки сетки -->
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: ширина 122px (для меток: "Название:", "Жанр:" и т.д.) -->
            <ColumnDefinition Width="137"/>
            <!-- Правая колонка: занимает всё оставшееся место (для полей ввода) -->
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Название фильма -->
        <TextBlock Grid.Column="0" Text="1. Название фильма:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0"/>
        <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Жанр -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Жанр:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0"/>
        <TextBox x:Name="txtGenre" Grid.Row="1" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Режиссёр -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Режиссёр:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0"/>
        <TextBox x:Name="txtDirector" Grid.Row="2" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Продолжительность -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="4. Продолжительность:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0"/>
        <TextBox x:Name="txtDuration" Grid.Row="3" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Возрастное ограничение -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="5. Возр. ограничение:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0" Grid.RowSpan="2"/>
        <ComboBox x:Name="cboAgeRating" Grid.Row="4" Grid.Column="1" Margin="9,5,9,5" Grid.RowSpan="2">
            <ComboBoxItem Content="0+"/>
            <ComboBoxItem Content="6+"/>
            <ComboBoxItem Content="12+"/>
            <ComboBoxItem Content="16+"/>
            <ComboBoxItem Content="18+"/>
        </ComboBox>

        <!-- Цена билета -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="6. Цена билета:" VerticalAlignment="Center" Height="16" Margin="5,0,5,0"/>
        <TextBox x:Name="txtPrice" Grid.Row="6" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="txtError" Grid.Row="7" Grid.ColumnSpan="2" 
           Foreground="Red" TextWrapping="Wrap" Margin="5,5,5,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" 
            Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,81" Width="188" Grid.RowSpan="1" Grid.Column="1">
            <Button x:Name="btnSave" Content="Сохранить" Width="81" 
            IsDefault="True" Click="BtnSave_Click" Height="29"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="81" 
            IsCancel="True" Click="BtnCancel_Click" Height="29"/>
        </StackPanel>
    </Grid>
</Window>
