<Window x:Class="Kino.Views.FilmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kino.Views"
        mc:Ignorable="d"
        Title="Фильм" 
        Height="400" Width="350" 
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="350"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="122"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Название фильма -->
        <TextBlock Grid.Column="0" Text="Название фильма:" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Жанр -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtGenre" Grid.Row="1" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Режиссёр -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Режиссёр:" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtDirector" Grid.Row="2" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Продолжительность -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Продолжительность:" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtDuration" Grid.Row="3" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Возрастное ограничение -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Возр. ограничение:" VerticalAlignment="Center" Height="16" Grid.RowSpan="2"/>
        <ComboBox x:Name="cboAgeRating" Grid.Row="4" Grid.Column="1" Margin="9,5,9,5" Grid.RowSpan="2">
            <ComboBoxItem Content="0+"/>
            <ComboBoxItem Content="6+"/>
            <ComboBoxItem Content="12+"/>
            <ComboBoxItem Content="16+"/>
            <ComboBoxItem Content="18+"/>
        </ComboBox>

        <!-- Цена билета -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена билета:" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtPrice" Grid.Row="6" Grid.Column="1" Margin="9,5,9,5"/>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="txtError" Grid.Row="7" Grid.ColumnSpan="2" 
           Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" 
            Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,24" Grid.Column="1" Width="219">
            <Button x:Name="btnSave" Content="Сохранить" Width="92" 
            IsDefault="True" Click="BtnSave_Click" Height="36"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="92" 
            IsCancel="True" Click="BtnCancel_Click" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
