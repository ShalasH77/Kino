<Window x:Class="Kino.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kino"
        mc:Ignorable="d"
        Title="Управление - Кинотеатр SHALASH" 
    Height="600" Width="1024"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки -->
        <TabControl Grid.Row="0" Margin="0,5,0,7">
            <!-- Вкладка "Фильмы" -->
            <TabItem Header="Фильмы"
                 FontSize="17" Background="#FFDBDA">
                <Grid Background="#FFDBDA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель кнопок -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,7">
                        <Button x:Name="btnAddFilm" Content="Добавить" Width="100" Click="BtnAddFilm_Click"/>
                        <Button x:Name="btnEditFilm" Content="Редактировать" Width="130" Click="BtnEditFilm_Click"/>
                        <Button x:Name="btnDeleteFilm" Content="Удалить" Width="100" Click="BtnDeleteFilm_Click"/>
                        <Button x:Name="btnRefreshFilms" Content="Обновить" Width="100" Click="BtnRefreshFilms_Click"/>
                    </StackPanel>

                    <!-- Таблица фильмов -->
                    <DataGrid x:Name="dgFilms" Grid.Row="1"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MouseDoubleClick="DgFilms_MouseDoubleClick" RenderTransformOrigin="0.475,0.497">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="27"/>
                            <DataGridTextColumn Header="Название фильма" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="115"/>
                            <DataGridTextColumn Header="Режиссёр" Binding="{Binding Director}" Width="150"/>
                            <DataGridTextColumn Header="Продолжительность (мин)" Binding="{Binding Duration}" Width="215"/>
                            <DataGridTextColumn Header="Возр. ограничение" Binding="{Binding AgeRating}" Width="158"/>
                            <DataGridTextColumn Header="Цена билета" Binding="{Binding Price, StringFormat={}{0:F2} ₽}" Width="108"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка "Сеансы" -->
            <TabItem Header="Сеансы"
                 FontSize="17" Background="#FFDBDA">
                <Grid Background="#FFDBDA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель кнопок -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,7">
                        <Button x:Name="btnAddSession" Content="Добавить" Width="100" Click="BtnAddSession_Click"/>
                        <Button x:Name="btnEditSession" Content="Редактировать" Width="130" Click="BtnEditSession_Click"/>
                        <Button x:Name="btnDeleteSession" Content="Удалить" Width="100" Click="BtnDeleteSession_Click"/>
                        <Button x:Name="btnRefreshSessions" Content="Обновить" Width="100" Click="BtnRefreshSessions_Click"/>
                    </StackPanel>

                    <!-- Таблица сеансов -->
                    <DataGrid x:Name="dgSessions" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MouseDoubleClick="DgSessions_MouseDoubleClick">

                        <!-- Содержимое таблицы -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="27"/>
                            <DataGridTextColumn Header="Название фильма" Binding="{Binding FilmName}" Width="200"/>
                            <DataGridTextColumn Header="Дата сеанса" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="109"/>
                            <DataGridTextColumn Header="Время начала" Binding="{Binding StartTime}" Width="117"/>
                            <DataGridTextColumn Header="Зал" Binding="{Binding Hall}" Width="50"/>
                            <DataGridTextColumn Header="Свободных мест" Binding="{Binding FreeSeats}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
